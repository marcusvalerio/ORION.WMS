# ORION WMS — variáveis de ambiente (copie para .env.local e ajuste).
# Nenhuma variável é obrigatória em desenvolvimento: sem DATABASE_URL o sistema
# usa um PostgreSQL embarcado (PGlite) persistido em .data/pglite.

# Conexão PostgreSQL/Supabase usada SOMENTE no servidor (nunca use prefixo NEXT_PUBLIC_).
# Ex.: string de conexão "Session pooler" do Supabase.
# DATABASE_URL=

# Diretório do banco embarcado quando DATABASE_URL não está definido.
# PGLITE_DATA_DIR=.data/pglite

# Segredo para assinar o cookie de sessão (obrigatório em produção, >= 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SESSION_SECRET=

# Carregar automaticamente os dados de demonstração quando o banco estiver vazio (padrão: true).
# WMS_AUTO_SEED=true
# Modo demonstração: abre sem login (automático na Vercel sem DATABASE_URL).
# WMS_DEMO_MODE=false
