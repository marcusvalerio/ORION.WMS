# ORION WMS — variáveis de ambiente (copie para .env.local e ajuste).
# Nenhuma variável é obrigatória em desenvolvimento: sem DATABASE_URL o sistema
# usa um PostgreSQL embarcado (PGlite) persistido em .data/pglite.

# Conexão PostgreSQL/Supabase usada SOMENTE no servidor (nunca use prefixo NEXT_PUBLIC_).
# Ex.: string de conexão "Session pooler" do Supabase.
# DATABASE_URL=

# Diretório do banco embarcado quando DATABASE_URL não está definido.
# PGLITE_DATA_DIR=.data/pglite

# Segredo para assinar o cookie de sessão (obrigatório em produção, >= 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SESSION_SECRET=

# Carregar automaticamente os dados de demonstração quando o banco estiver vazio (padrão: true).
# WMS_AUTO_SEED=true
# Modo demonstração: abre sem login (automático na Vercel sem DATABASE_URL).
# WMS_DEMO_MODE=false

# --- Integração com o ATLAS.ERP (dados da empresa) ---------------------------
# String de conexão Postgres de um usuário SOMENTE LEITURA do ATLAS, com
# GRANT SELECT apenas em public.companies (ver README). Só no servidor.
# ATLAS_DATABASE_URL=postgres://orion_wms_reader:<senha>@atlas-db:5432/atlas

# --- Outbox de integração (envio de eventos ao ERP) --------------------------
# Transporte: local (aplica no schema erp deste banco) ou http. Sem a variável,
# usa http quando ERP_WEBHOOK_URL existe, senão local.
# ERP_OUTBOX_TRANSPORT=local
# Endpoint que recebe POST JSON assinado com HMAC-SHA256 (X-Orion-Signature).
# ERP_WEBHOOK_URL=https://erp.exemplo.com.br/webhooks/orion
# Segredo compartilhado da assinatura (>= 16 caracteres; recomendado >= 32).
# ERP_WEBHOOK_SECRET=
# Tempo máximo de cada envio em ms (padrão 10000).
# ERP_WEBHOOK_TIMEOUT_MS=10000
# Token que protege POST/GET /api/integracao/processar (Vercel Cron envia
# "Authorization: Bearer <CRON_SECRET>" automaticamente). >= 16 caracteres.
# CRON_SECRET=
